<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BaiTapBuoi3.WinForms</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(FileName)%(Extension)" />
    <Compile Include="..\DataAccess\**\*.cs" Link="DataAccess\%(RecursiveDir)%(FileName)%(Extension)" />
    <Compile Include="..\Business\**\*.cs" Link="Business\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
